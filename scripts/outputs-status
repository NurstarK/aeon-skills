#!/usr/bin/env bash
# outputs-status — list .outputs/*.md with embedded content date and age in days
#
# Usage:
#   ./scripts/outputs-status                  # table for every .outputs/*.md
#   ./scripts/outputs-status --json           # machine-readable JSON
#   ./scripts/outputs-status --stale 3        # only files >= 3 days stale
#   ./scripts/outputs-status --dir path/      # use a different outputs directory
#   ./scripts/outputs-status --help           # this message
#
# Skills' synthesizers and the operator both peek `.outputs/*.md` daily to decide
# whether a file is fresh enough to re-use. This tool extracts the FIRST
# YYYY-MM-DD found in the first 10 lines of each file, compares to today, and
# reports the staleness in days. mtimes are intentionally ignored because
# `git checkout` rewrites them on every CI run — only embedded content dates
# survive.
#
# Exit codes:
#   0  success
#   1  generic failure
#   64 usage error           (EX_USAGE)
#   75 transient failure     (EX_TEMPFAIL — unused; no network)
#   78 missing configuration (EX_CONFIG — outputs dir missing)
#
# Used by: skill synthesizers that gate on input freshness (agentic-crypto-scout
#   chain handler, narrative-tracker dedup baseline, agent-buzz dedup) and the
#   operator. Read-only — no --dry-run gate because the tool makes no writes,
#   no network calls, and no API requests.
# Dependencies: bash, grep, date (GNU)

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

OUTPUTS_DIR="${SCRIPT_DIR}/.outputs"
FORMAT="text"
STALE_THRESHOLD=""

print_help() {
  sed -n '2,29p' "$0" | sed 's/^# \?//'
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) FORMAT="json"; shift ;;
    --stale)
      [[ $# -lt 2 ]] && { echo "error: --stale requires an integer" >&2; exit 64; }
      STALE_THRESHOLD="$2"
      [[ ! "$STALE_THRESHOLD" =~ ^[0-9]+$ ]] && { echo "error: --stale value must be a non-negative integer" >&2; exit 64; }
      shift 2 ;;
    --dir)
      [[ $# -lt 2 ]] && { echo "error: --dir requires a path" >&2; exit 64; }
      OUTPUTS_DIR="$2"
      shift 2 ;;
    -h|--help) print_help; exit 0 ;;
    *) echo "error: unknown arg: $1" >&2; exit 64 ;;
  esac
done

if [ ! -d "$OUTPUTS_DIR" ]; then
  echo "error: outputs directory not found: $OUTPUTS_DIR" >&2
  exit 78
fi

TODAY=$(date -u +%Y-%m-%d)
TODAY_EPOCH=$(date -u -d "$TODAY" +%s 2>/dev/null) || {
  echo "error: GNU date required (date -d)" >&2
  exit 1
}

# Collect rows: name<TAB>content_date<TAB>age_days<TAB>size_bytes
ROWS=""
shopt -s nullglob
for f in "$OUTPUTS_DIR"/*.md; do
  name=$(basename "$f")
  content_date=$(grep -oE '\b20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])\b' "$f" 2>/dev/null | head -1 || true)
  if [ -n "$content_date" ]; then
    file_epoch=$(date -u -d "$content_date" +%s 2>/dev/null || echo "")
    if [ -n "$file_epoch" ]; then
      age=$(( (TODAY_EPOCH - file_epoch) / 86400 ))
    else
      age="-"
    fi
  else
    content_date="-"
    age="-"
  fi
  size=$(wc -c < "$f" | tr -d ' ')
  ROWS+="${name}	${content_date}	${age}	${size}"$'\n'
done
shopt -u nullglob

if [ -z "$ROWS" ]; then
  if [ "$FORMAT" = "json" ]; then
    printf '{"today":"%s","dir":"%s","files":[]}\n' "$TODAY" "$OUTPUTS_DIR"
  else
    echo "no .md files in $OUTPUTS_DIR" >&2
  fi
  exit 0
fi

# Apply --stale filter (numeric ages only)
if [ -n "$STALE_THRESHOLD" ]; then
  FILTERED=""
  while IFS=$'\t' read -r name cdate age size; do
    [ -z "$name" ] && continue
    if [[ "$age" =~ ^[0-9]+$ ]] && [ "$age" -ge "$STALE_THRESHOLD" ]; then
      FILTERED+="${name}	${cdate}	${age}	${size}"$'\n'
    fi
  done <<< "$ROWS"
  ROWS="$FILTERED"
fi

# Sort by descending age (numeric first, then "-" last), tiebreak by name
SORTED=$(printf '%s' "$ROWS" | awk -F'\t' 'NF>=4 {
  key = ($3 ~ /^[0-9]+$/) ? sprintf("%010d", 9999999999 - $3) : "9999999999";
  printf "%s\t%s\n", key, $0
}' | sort | cut -f2-)

if [ "$FORMAT" = "json" ]; then
  printf '{"today":"%s","dir":"%s","files":[' "$TODAY" "$OUTPUTS_DIR"
  first=1
  while IFS=$'\t' read -r name cdate age size; do
    [ -z "$name" ] && continue
    if [ $first -eq 0 ]; then printf ','; fi
    first=0
    age_json="null"; [[ "$age" =~ ^[0-9]+$ ]] && age_json="$age"
    cdate_json="null"; [ "$cdate" != "-" ] && cdate_json="\"$cdate\""
    printf '{"name":"%s","content_date":%s,"age_days":%s,"size_bytes":%s}' \
      "$name" "$cdate_json" "$age_json" "$size"
  done <<< "$SORTED"
  printf ']}\n'
  exit 0
fi

printf '%-32s %-12s %5s %8s\n' "FILE" "DATE" "AGE" "BYTES" >&2
printf '%-32s %-12s %5s %8s\n' "----" "----" "---" "-----" >&2
while IFS=$'\t' read -r name cdate age size; do
  [ -z "$name" ] && continue
  printf '%-32s %-12s %5s %8s\n' "$name" "$cdate" "$age" "$size"
done <<< "$SORTED"
